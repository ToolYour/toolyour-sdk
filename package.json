{
  "name": "@toolyour/sdk",
  "version": "0.1.3",
  "description": "Official TypeScript client for the ToolYour API and MCP-backed tools — SEO, security, conversion, text, and more.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    }
  },
  "files": [
    "dist",
    "openapi/sync.lock.json",
    "README.md",
    "LICENSE",
    "MAINTENANCE.md"
  ],
  "scripts": {
    "sync": "node scripts/sync-from-platform.mjs",
    "generate": "node scripts/generate-sdk.mjs",
    "sync:generate": "npm run sync && npm run generate",
    "build": "tsup src/index.ts src/mcp/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "toolyour",
    "mcp",
    "mcp-server",
    "seo-api",
    "security-api",
    "file-conversion-api",
    "cursor",
    "claude",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToolYour/toolyour-sdk.git"
  },
  "homepage": "https://www.toolyour.com/developers",
  "bugs": {
    "url": "https://github.com/ToolYour/toolyour-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^3.0.5"
  },
  "sideEffects": false
}
